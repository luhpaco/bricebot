{
	"env": {
		"node": true,
		"es2021": true
	},
	"extends": ["eslint:recommended", "prettier"],
	"parserOptions": {
		"ecmaVersion": 2021,
		"sourceType": "script"
	},
	"rules": {
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
	},
	"overrides": [
		{
			"files": ["fulfillment/tests/**/*.js"],
			"env": {
				"jest": true
			}
		}
	]
}
