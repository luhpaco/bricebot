## Integration Testing

### Webhook Integration Test
```javascript
const request = require('supertest');
const app = require('../src/index');

describe('Dialogflow Webhook', () => {
  describe('POST /webhook', () => {
    it('should handle faq_horarios intent', async () => {
      const dialogflowRequest = {
        responseId: 'test-response-id',
        queryResult: {
          intent: {
            displayName: 'faq_horarios'
          },
          parameters: {},
          outputContexts: []
        }
      };

      const response = await request(app)
        .post('/webhook')
        .send(dialogflowRequest)
        .expect(200);

      expect(response.body.fulfillmentText).toContain('horarios');
    });

    it('should handle appointment flow with context', async () => {
      // Test multi-turn conversation
      const requests = [
        { intent: 'cita_iniciar', expectedContext: 'cita_seleccion_tipo' },
        { intent: 'cita_local_iniciar', context: 'cita_seleccion_tipo', expectedContext: 'cita_local_en_curso' },
        // ... more steps
      ];

      let currentContexts = [];
      
      for (const step of requests) {
        const response = await request(app)
          .post('/webhook')
          .send(buildRequest(step.intent, step.parameters, currentContexts))
          .expect(200);

        if (step.expectedContext) {
          const outputContexts = response.body.outputContexts || [];
          expect(outputContexts.some(c => c.name.includes(step.expectedContext))).toBe(true);
        }
        
        currentContexts = response.body.outputContexts || [];
      }
    });
  });
});
```

### Database Integration Test
```javascript
describe('AppointmentRepository', () => {
  beforeEach(async () => {
    await Appointment.deleteMany({});
  });

  it('should create and retrieve appointment', async () => {
    const appointmentData = {
      clientName: 'Test Client',
      phone: '+51999999999',
      equipmentType: 'laptop',
      problemDescription: 'No enciende',
      appointmentType: 'local',
      scheduledDate: new Date('2026-02-15'),
      scheduledTime: '10:00'
    };

    const created = await appointmentRepository.create(appointmentData);
    const retrieved = await appointmentRepository.findById(created._id);

    expect(retrieved.clientName).toBe(appointmentData.clientName);
    expect(retrieved.status).toBe('pendiente');
  });

  it('should find available slots', async () => {
    // Seed existing appointments
    await Appointment.create([
      { scheduledDate: new Date('2026-02-15'), scheduledTime: '10:00', status: 'confirmada' },
      { scheduledDate: new Date('2026-02-15'), scheduledTime: '11:00', status: 'confirmada' },
      { scheduledDate: new Date('2026-02-15'), scheduledTime: '12:00', status: 'confirmada' }
    ]);

    const slots = await appointmentRepository.getAvailableSlots('2026-02-15');
    
    expect(slots).not.toContain('10:00');
    expect(slots).not.toContain('11:00');
    expect(slots).toContain('14:00'); // Afternoon still available
  });
});
```

