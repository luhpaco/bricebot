## Mocking Guidelines

### Mocking MongoDB
```javascript
const { MongoMemoryServer } = require('mongodb-memory-server');
const mongoose = require('mongoose');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

beforeEach(async () => {
  await mongoose.connection.dropDatabase();
});
```

### Mocking Dialogflow Agent
```javascript
const createMockAgent = (parameters = {}, contexts = []) => ({
  parameters,
  getContext: jest.fn((name) => contexts.find(c => c.name === name)),
  setContext: jest.fn(),
  clearContext: jest.fn(),
  add: jest.fn(),
  end: jest.fn(),
  request_: {
    body: {
      queryResult: {
        parameters,
        outputContexts: contexts
      }
    }
  }
});

// Usage
it('should respond with business hours', async () => {
  const agent = createMockAgent();
  
  await faqHorariosHandler(agent);
  
  expect(agent.add).toHaveBeenCalledWith(
    expect.stringContaining('Lunes a Viernes')
  );
});
```

