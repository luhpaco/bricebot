## 💻 CODING STANDARDS

### JavaScript/Node.js Conventions

- Use ES6+ syntax (const/let, arrow functions, async/await)
- Use camelCase for variables and functions
- Use PascalCase for classes and constructors
- Use UPPER_SNAKE_CASE for constants
- Always use semicolons
- Prefer async/await over callbacks/promise chains
- Maximum line length: 100 characters
- Use JSDoc comments for all exported functions

### Intent Handler Pattern

```javascript
/**
 * Handles the appointment scheduling intent
 * @param {Object} agent - Dialogflow WebhookClient agent
 * @returns {Promise<void>}
 */
const handleAppointmentIntent = async (agent) => {
	const startTime = Date.now();
	const { parameters } = agent;

	try {
		// 1. Validate required parameters
		if (!parameters['fecha'] || !parameters['hora']) {
			agent.add('Por favor, indique la fecha y hora para su cita.');
			return;
		}

		// 2. Execute business logic
		const result = await appointmentService.scheduleAppointment({
			date: parameters['fecha'],
			time: parameters['hora'],
			clientName: parameters['nombre_cliente'],
			phone: parameters['telefono'],
		});

		// 3. Record metrics (for thesis evaluation)
		await metricsService.recordInteraction({
			intent: agent.intent,
			startTime,
			endTime: Date.now(),
			success: true,
		});

		// 4. Respond to user
		agent.add(`✅ Su cita ha sido agendada para el ${result.formattedDate}`);
	} catch (error) {
		logger.error('Appointment scheduling failed:', error);

		await metricsService.recordInteraction({
			intent: agent.intent,
			startTime,
			endTime: Date.now(),
			success: false,
			error: error.message,
		});

		agent.add(
			'Lo sentimos, hubo un problema al agendar su cita. ¿Desea intentar nuevamente?',
		);
	}
};
```

### Error Handling Pattern

```javascript
const handleIntent = async (agent) => {
	try {
		// Intent logic
	} catch (error) {
		if (error instanceof ValidationError) {
			agent.add(error.userMessage);
		} else if (error instanceof ExternalServiceError) {
			agent.add(MESSAGES.EXTERNAL_SERVICE_ERROR);
			await notifyAdmin(error);
		} else {
			agent.add(MESSAGES.GENERIC_ERROR);
			logger.error('Unexpected error:', error);
		}
	}
};
```

### Webhook Response Builder

```javascript
const buildResponse = (message, suggestions = []) => {
	return {
		fulfillmentText: message,
		fulfillmentMessages: [
			{ text: { text: [message] } },
			suggestions.length > 0
				? {
						quickReplies: {
							title: '¿Qué desea hacer?',
							quickReplies: suggestions,
						},
				  }
				: null,
		].filter(Boolean),
	};
};
```

