# Dialogflow
DIALOGFLOW_PROJECT_ID=your-project-id-here
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# MongoDB Local
MONGODB_URI=mongodb://localhost:27017/cbricenho
MONGODB_DB_NAME=cbricenho

# Google Calendar
# IMPORTANT: Do NOT use "primary" with Service Accounts — it refers to the SA's own invisible calendar.
# Use the email of the Google account whose calendar you shared, or a specific calendar ID.
GOOGLE_CALENDAR_ID=your-email@gmail.com
GOOGLE_CALENDAR_TIMEZONE=America/Lima

# App Configuration
NODE_ENV=development
PORT=3000
SESSION_TIMEOUT_MINUTES=30
MAX_BOOKING_DAYS=7
QUOTE_VALIDITY_DAYS=7
IGV_PERCENTAGE=18

# Appointments Configuration
MAX_SIMULTANEOUS_APPOINTMENTS=3
APPOINTMENT_SLOT_DURATION_MINUTES=60

