{
	"name": "bricebot",
	"version": "1.0.0",
	"description": "Chatbot para atencion al cliente - CBRICENHO E.I.R.L",
	"main": "fulfillment/src/index.js",
	"scripts": {
		"start": "node fulfillment/src/index.js",
		"dev": "nodemon fulfillment/src/index.js",
		"test": "jest --coverage",
		"test:unit": "jest --testPathPattern=fulfillment/tests --coverage",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"jest": {
		"testEnvironment": "node",
		"testMatch": [
			"**/fulfillment/tests/**/*.test.js"
		],
		"setupFiles": [],
		"coverageDirectory": "coverage",
		"collectCoverageFrom": [
			"fulfillment/src/handlers/**/*.js",
			"fulfillment/src/services/**/*.js",
			"fulfillment/src/utils/**/*.js",
			"fulfillment/src/models/**/*.js"
		],
		"coverageThreshold": {
			"./fulfillment/src/handlers/faq.handler.js": {
				"statements": 90,
				"functions": 90,
				"lines": 90
			},
			"./fulfillment/src/services/metrics.service.js": {
				"statements": 75,
				"functions": 75,
				"lines": 75
			},
			"./fulfillment/src/utils/validators.js": {
				"statements": 75,
				"functions": 85,
				"lines": 75
			},
			"./fulfillment/src/utils/dateHelpers.js": {
				"statements": 55,
				"functions": 65,
				"lines": 55
			},
			"./fulfillment/src/services/quotes.service.js": {
				"statements": 75,
				"functions": 75,
				"lines": 75
			}
		}
	},
	"keywords": [
		"chatbot",
		"dialogflow",
		"customer-service",
		"messenger"
	],
	"author": "Luis Humberto Paz Córdova",
	"license": "MIT",
	"dependencies": {
		"dialogflow-fulfillment": "^0.6.1",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"googleapis": "^128.0.0",
		"mongoose": "^8.0.0"
	},
	"devDependencies": {
		"eslint": "^8.55.0",
		"eslint-config-prettier": "^10.1.8",
		"jest": "^29.7.0",
		"mongodb-memory-server": "^9.5.0",
		"nodemon": "^3.0.2",
		"prettier": "^3.8.4"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
